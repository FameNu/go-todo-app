# Use the connection string Supabase provides. Port 5432 is Session mode;
# port 6543 is Transaction mode. Keep sslmode=require for hosted databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Render injects PORT automatically; this is the local fallback.
PORT=8080

# Comma-separated browser origins. Add the deployed Vercel URL here.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
